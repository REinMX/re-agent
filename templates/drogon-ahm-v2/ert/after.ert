-- AFTER: facies SCAL, localized log-permeability FIELD, native RFT and breakthrough.
DEFINE <CASE>      after
DEFINE <SCRATCH>   <CONFIG_PATH>/../scratch_v2
DEFINE <DECK>      <CONFIG_PATH>/../deck
NUM_REALIZATIONS   16
RANDOM_SEED        20261015
RUNPATH            <SCRATCH>/<CASE>/realization-<IENS>/iter-<ITER>
ENSPATH            <CONFIG_PATH>/../output/<CASE>/storage
UPDATE_LOG_PATH    <CONFIG_PATH>/../output/<CASE>/update_log
RUNPATH_FILE       <CONFIG_PATH>/../output/<CASE>/runpath_file
ECLBASE            model/DROGON-<IENS>
RUN_TEMPLATE       <DECK>/model/DROGON_V2.DATA  <ECLBASE>.DATA

QUEUE_SYSTEM       LOCAL
QUEUE_OPTION       LOCAL MAX_RUNNING 3
NUM_CPU            1
MAX_RUNTIME        3600
MIN_REALIZATIONS   12
MAX_SUBMIT         1

GEN_KW DROGON after.dist
GRID <CONFIG_PATH>/../static/DROGON.EGRID
FIELD LNPERM PARAMETER lnpermmult.grdecl INIT_FILES:<CONFIG_PATH>/../static/fields/field_%d.grdecl
ANALYSIS_SET_VAR PARAMETERS FIELD DISTANCE
ANALYSIS_SET_VAR PARAMETERS GEN_KW GLOBAL
OBS_CONFIG obs/after.obs

INSTALL_JOB DROGON_PARAMS_V2 jobs/DROGON_PARAMS_V2
INSTALL_JOB DROGON_SCAL jobs/DROGON_SCAL
INSTALL_JOB DROGON_POST   jobs/DROGON_POST
FORWARD_MODEL COPY_DIRECTORY(<FROM>=<DECK>/include, <TO>=<RUNPATH>/include)
FORWARD_MODEL DROGON_PARAMS_V2
FORWARD_MODEL DROGON_SCAL
FORWARD_MODEL FLOW(<ECLBASE>=<ECLBASE>)
FORWARD_MODEL DROGON_POST

SUMMARY WOPR:* WWCT:* WGOR:* WBHP:* WWIR:* WGPR:* WWPR:*
SUMMARY FOPT FOPR FWPT FGPT FWIT FPR FWCT FGOR
RFT WELL:R_A2 DATE:2018-03-01 PROPERTIES:PRESSURE
RFT WELL:R_A3 DATE:2018-07-03 PROPERTIES:PRESSURE
RFT WELL:R_A4 DATE:2018-09-12 PROPERTIES:PRESSURE
RFT WELL:R_A5 DATE:2018-04-28 PROPERTIES:PRESSURE
RFT WELL:R_A6 DATE:2018-11-07 PROPERTIES:PRESSURE
