-- BEFORE: the D1 Drogon AHM setup (GEN_KW only, power-law SCAL, RFT_EXTRACT + GEN_DATA), loaded in ERT 26.
-- Changes from case/ert/drogon_ahm.ert: own ENSPATH and RUNPATH, and the DROGON_POST step after FLOW
-- (SWATINIT QC volumes, UNRST removed except realization 0). The model is unchanged.
DEFINE <CASE>      before
DEFINE <SCRATCH>   <CONFIG_PATH>/../scratch_v2
DEFINE <DECK>      <CONFIG_PATH>/../deck
NUM_REALIZATIONS   16
RANDOM_SEED        20261015
RUNPATH            <SCRATCH>/<CASE>/realization-<IENS>/iter-<ITER>
ENSPATH            <CONFIG_PATH>/../output/<CASE>/storage
UPDATE_LOG_PATH    <CONFIG_PATH>/../output/<CASE>/update_log
RUNPATH_FILE       <CONFIG_PATH>/../output/<CASE>/runpath_file
ECLBASE            model/DROGON-<IENS>
RUN_TEMPLATE       <DECK>/model/DROGON_AHM.DATA  <ECLBASE>.DATA

QUEUE_SYSTEM       LOCAL
QUEUE_OPTION       LOCAL MAX_RUNNING 3
NUM_CPU            1
MAX_RUNTIME        3600
MIN_REALIZATIONS   12
MAX_SUBMIT         1

GEN_KW DROGON drogon.dist
OBS_CONFIG obs/drogon.obs

INSTALL_JOB DROGON_PARAMS jobs/DROGON_PARAMS
INSTALL_JOB RFT_EXTRACT   jobs/RFT_EXTRACT
INSTALL_JOB DROGON_POST   jobs/DROGON_POST
FORWARD_MODEL COPY_DIRECTORY(<FROM>=<DECK>/include, <TO>=<RUNPATH>/include)
FORWARD_MODEL DROGON_PARAMS
FORWARD_MODEL FLOW(<ECLBASE>=<ECLBASE>)
FORWARD_MODEL RFT_EXTRACT
FORWARD_MODEL DROGON_POST

SUMMARY WOPR:* WWCT:* WGOR:* WBHP:* WWIR:* WGPR:* WWPR:*
SUMMARY FOPT FOPR FWPT FGPT FWIT FPR FWCT FGOR
GEN_DATA RFT_R_A2 RESULT_FILE:rft_R_A2_%d.txt REPORT_STEPS:1
GEN_DATA RFT_R_A3 RESULT_FILE:rft_R_A3_%d.txt REPORT_STEPS:1
GEN_DATA RFT_R_A4 RESULT_FILE:rft_R_A4_%d.txt REPORT_STEPS:1
GEN_DATA RFT_R_A5 RESULT_FILE:rft_R_A5_%d.txt REPORT_STEPS:1
GEN_DATA RFT_R_A6 RESULT_FILE:rft_R_A6_%d.txt REPORT_STEPS:1
