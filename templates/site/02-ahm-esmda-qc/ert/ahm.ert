-- {{param:case_name}}: ES-MDA history match. Site values come from the site contract profile.
-- es_mda --weights {{param:esmda_weights}}
DEFINE <CASE>      {{param:case_name}}
DEFINE <SCRATCH>   {{site:scratch_root}}
DEFINE <DECK_DIR>  {{param:deck_dir}}
NUM_REALIZATIONS   {{param:num_realizations}}
MIN_REALIZATIONS   {{param:min_realizations}}
RANDOM_SEED        {{param:random_seed}}
RUNPATH            <SCRATCH>/<CASE>/realization-<IENS>/iter-<ITER>
ENSPATH            <CONFIG_PATH>/../output/<CASE>/storage
UPDATE_LOG_PATH    <CONFIG_PATH>/../output/<CASE>/update_log
RUNPATH_FILE       <CONFIG_PATH>/../output/<CASE>/runpath_file
ECLBASE            {{param:eclbase}}

QUEUE_SYSTEM       {{site:queue.system}}
QUEUE_OPTION       {{site:queue.system}} MAX_RUNNING {{site:queue.max_running}}
QUEUE_OPTION       {{site:queue.system}} {{param:queue_name_option}} {{site:queue.name}}
-- NUM_CPU > 1 means MPI for FLOW. Do not give FLOW a --threads argument.
NUM_CPU            {{param:num_cpu}}
MAX_RUNTIME        {{param:max_runtime}}
MAX_SUBMIT         1

OBS_CONFIG         ../{{param:obs_config}}
INCLUDE            ../{{param:prior_dir}}/ert/model.ert

-- Update strategy per parameter type (ERT 23+; ERT 26 removed STD_ENKF LOCALIZATION).
ANALYSIS_SET_VAR   PARAMETERS GEN_KW {{param:gen_kw_update}}
ANALYSIS_SET_VAR   PARAMETERS FIELD {{param:field_update}}
